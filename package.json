{
  "name": "vscode-review-relay",
  "displayName": "Review Relay",
  "description": "Live review comments shared between VS Code and local AI tools.",
  "version": "0.4.1",
  "publisher": "statiolake",
  "license": "MIT",
  "author": "statiolake",
  "repository": {
    "type": "git",
    "url": "https://github.com/statiolake/vscode-review-relay.git"
  },
  "homepage": "https://github.com/statiolake/vscode-review-relay#readme",
  "bugs": {
    "url": "https://github.com/statiolake/vscode-review-relay/issues"
  },
  "keywords": [
    "review",
    "comments",
    "coding agent",
    "AI",
    "diff"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewRelay",
          "title": "Review Relay",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "reviewRelay": [
        {
          "id": "reviewRelay.comments",
          "name": "Comments"
        },
        {
          "id": "reviewRelay.review",
          "name": "Review",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "reviewRelay.addComment",
        "title": "Review Relay: Add Comment"
      },
      {
        "command": "reviewRelay.replyAtCursor",
        "title": "Review Relay: Reply to Thread on Current Line"
      },
      {
        "command": "reviewRelay.editAtCursor",
        "title": "Review Relay: Edit Comment on Current Line"
      },
      {
        "command": "reviewRelay.deleteCommentAtCursor",
        "title": "Review Relay: Delete Comment on Current Line"
      },
      {
        "command": "reviewRelay.deleteThreadAtCursor",
        "title": "Review Relay: Delete Thread on Current Line"
      },
      {
        "command": "reviewRelay.toggleThreadAtCursor",
        "title": "Review Relay: Show or Hide Thread on Current Line"
      },
      {
        "command": "reviewRelay.toggleResolveAtCursor",
        "title": "Review Relay: Resolve or Reopen Thread on Current Line"
      },
      {
        "command": "reviewRelay.resolveThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "reviewRelay.unresolveThread",
        "title": "Reopen",
        "icon": "$(discard)"
      },
      {
        "command": "reviewRelay.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "reviewRelay.saveComment",
        "title": "Save",
        "icon": "$(check)"
      },
      {
        "command": "reviewRelay.cancelEditComment",
        "title": "Cancel",
        "icon": "$(close)"
      },
      {
        "command": "reviewRelay.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "reviewRelay.copyCommentId",
        "title": "Copy Comment ID",
        "icon": "$(copy)"
      },
      {
        "command": "reviewRelay.submitComment",
        "title": "Add Comment"
      },
      {
        "command": "reviewRelay.replyComment",
        "title": "Reply"
      },
      {
        "command": "reviewRelay.copyEndpoint",
        "title": "Review Relay: Copy API Endpoint"
      },
      {
        "command": "reviewRelay.copyAgentInstructions",
        "title": "Review Relay: Copy Agent Instructions"
      },
      {
        "command": "reviewRelay.copyMarkdown",
        "title": "Review Relay: Copy as Markdown",
        "icon": "$(clippy)"
      },
      {
        "command": "reviewRelay.clearReview",
        "title": "Review Relay: Clear Review",
        "icon": "$(clear-all)"
      },
      {
        "command": "reviewRelay.clearComments",
        "title": "Review Relay: Clear All Comments"
      },
      {
        "command": "reviewRelay.navigateTreeComment",
        "title": "Reveal Comment"
      },
      {
        "command": "reviewRelay.deleteTreeComment",
        "title": "Delete Comment",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reviewRelay.submitComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.replyComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.editComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.saveComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.cancelEditComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.deleteComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.copyCommentId",
          "when": "false"
        },
        {
          "command": "reviewRelay.navigateTreeComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.deleteTreeComment",
          "when": "false"
        },
        {
          "command": "reviewRelay.replyAtCursor",
          "when": "reviewRelay.cursorOnThread"
        },
        {
          "command": "reviewRelay.editAtCursor",
          "when": "reviewRelay.cursorOnThread"
        },
        {
          "command": "reviewRelay.deleteCommentAtCursor",
          "when": "reviewRelay.cursorOnThread"
        },
        {
          "command": "reviewRelay.deleteThreadAtCursor",
          "when": "reviewRelay.cursorOnThread"
        },
        {
          "command": "reviewRelay.toggleThreadAtCursor",
          "when": "reviewRelay.cursorOnThread"
        },
        {
          "command": "reviewRelay.toggleResolveAtCursor",
          "when": "reviewRelay.cursorOnThread"
        },
        {
          "command": "reviewRelay.resolveThread",
          "when": "false"
        },
        {
          "command": "reviewRelay.unresolveThread",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "reviewRelay.addComment",
          "group": "navigation@50",
          "when": "editorTextFocus"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "reviewRelay.submitComment",
          "group": "inline",
          "when": "commentController == review-relay && commentThreadIsEmpty"
        },
        {
          "command": "reviewRelay.replyComment",
          "group": "inline",
          "when": "commentController == review-relay && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "reviewRelay.copyCommentId",
          "group": "inline@1",
          "when": "commentController == review-relay && comment == preview"
        },
        {
          "command": "reviewRelay.editComment",
          "group": "inline@2",
          "when": "commentController == review-relay && comment == preview"
        },
        {
          "command": "reviewRelay.deleteComment",
          "group": "inline@3",
          "when": "commentController == review-relay && comment == preview"
        }
      ],
      "comments/comment/context": [
        {
          "command": "reviewRelay.saveComment",
          "group": "inline@1",
          "when": "commentController == review-relay && comment == editing"
        },
        {
          "command": "reviewRelay.cancelEditComment",
          "group": "inline@2",
          "when": "commentController == review-relay && comment == editing"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewRelay.copyCommentId",
          "group": "inline@1",
          "when": "view == reviewRelay.comments && viewItem == reviewRelayComment"
        },
        {
          "command": "reviewRelay.deleteTreeComment",
          "group": "inline@2",
          "when": "view == reviewRelay.comments && viewItem == reviewRelayComment"
        },
        {
          "command": "reviewRelay.copyCommentId",
          "group": "navigation@1",
          "when": "view == reviewRelay.comments && viewItem == reviewRelayComment"
        },
        {
          "command": "reviewRelay.deleteTreeComment",
          "group": "navigation@2",
          "when": "view == reviewRelay.comments && viewItem == reviewRelayComment"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "reviewRelay.resolveThread",
          "group": "inline@1",
          "when": "commentController == review-relay && commentThread == unresolved"
        },
        {
          "command": "reviewRelay.unresolveThread",
          "group": "inline@1",
          "when": "commentController == review-relay && commentThread == resolved"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build:cli:all && esbuild src/extension.ts --bundle --minify --platform=node --external:vscode --outfile=dist/extension.js",
    "build": "npm run build:cli && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "build:cli": "node scripts/build-cli.mjs",
    "build:cli:all": "node scripts/build-cli.mjs --all",
    "package": "vsce package",
    "publish": "npm run publish:vsce && npm run publish:ovsx",
    "check": "tsc --noEmit",
    "test": "npm run test:compile && node --test dist-test/test/**/*.test.js && go test ./...",
    "test:compile": "tsc -p tsconfig.test.json",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "vscode-uri": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.24.2",
    "ovsx": "^1.1.1",
    "typescript": "^5.7.2"
  }
}
